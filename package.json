{
  "name": "@sonn-audio/node-airplay",
  "version": "0.1.0",
  "description": "AirPlay for Node.js in pure TypeScript \u2014 sender and receiver, AirPlay 1 (RAOP) and AirPlay 2 (HAP, PTP, encrypted RTSP)",
  "license": "Apache-2.0",
  "author": "Rudy Berends",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "README.md",
    "NOTICE",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5.6"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test dist"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sonn-audio/node-airplay.git"
  },
  "keywords": [
    "airplay",
    "raop",
    "airplay2",
    "alac",
    "ptp",
    "rtsp",
    "audio"
  ]
}
